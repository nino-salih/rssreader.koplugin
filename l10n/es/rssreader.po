msgid "Only articles of a server account can be reloaded."
msgstr "Solo se pueden recargar artículos de una cuenta de servidor."

#: rssreader_ui_tree.lua:328
#, c-format
msgid "%d article(s) reloaded, the rest failed."
msgstr "%d artículo(s) recargado(s), el resto falló."

